# Copy this file to .env and adjust as needed. scripts/06_store.py reads these
# (real environment variables, if set, take precedence over .env).

# Local embedding model (sentence-transformers). No API key required.
# BAAI/bge-base-en-v1.5: stronger general-purpose retrieval than MiniLM, does noticeably
# better on technical/support text. Queries are auto-prefixed with the BGE instruction
# string at query time (see 07_retrieve.py); passages are embedded as-is.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Cross-encoder used to rerank the top candidates after BM25+vector fusion. Small and
# fast (~80MB); only scores a short list (RERANK_TOP_N in 07_retrieve.py), not the whole store.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Where the ChromaDB persistent vector store is written.
VECTOR_DB_PATH=data/processed/store/vector

# Where the BM25 index is written.
BM25_PATH=data/processed/store/bm25

# How many chunks to embed per batch.
EMBEDDING_BATCH_SIZE=64

# --- Understanding + Normalization (09_understand.py) ---
# LLM used to extract structured fields from a raw customer query. Provider/model are
# fully swappable -- only the SDK for whichever provider you pick needs to be installed.
# Supported providers: gemini | anthropic | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Set ONLY the key matching LLM_PROVIDER above.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
